# Level 9 with phpstan-strict-rules; the monorepo CI runs this same file per package.
includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: 9
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    scanFiles:
        # class Yii is defined by a file that registers its own autoloader
        - vendor/yiisoft/yii2/Yii.php
