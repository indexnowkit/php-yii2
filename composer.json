{
    "name": "indexnowkit/yii2",
    "description": "IndexNow for Yii2: notify Yandex, Bing, Naver and Seznam when ActiveRecord rows change. #[IndexNow] attribute on the model, commit-safe without transaction hooks, key file route, console commands, yii2-queue dispatch.",
    "type": "yii2-extension",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "yii2",
        "activerecord",
        "seo",
        "yandex",
        "bing",
        "indexing"
    ],
    "homepage": "https://github.com/indexnowkit/php-yii2",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-yii2",
        "docs": "https://github.com/indexnowkit/php-yii2/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-yii2/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "indexnowkit/core": "^0.5.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "yiisoft/yii2": "^2.0.45",
        "yiisoft/yii2-composer": "^2.0.10"
    },
    "require-dev": {
        "indexnowkit/sitemap": "^0.1.1",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "yidas/yii2-composer-bower-skip": "^2.0",
        "yiisoft/yii2-queue": "^2.3"
    },
    "suggest": {
        "indexnowkit/sitemap": "The indexnow/sitemap command (^0.1.1)",
        "yiisoft/yii2-queue": "dispatch: queue — SubmitUrlsJob with retries in a worker",
        "symfony/http-client": "PSR-18 client for the submissions (with nyholm/psr7); any PSR-18 client works",
        "nyholm/psr7": "PSR-17 factories for the PSR-18 client"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Yii2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Yii2\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
